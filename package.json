{
  "name": "international-ebp-directory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "International Directory of Evidence-Based Policing \u2014 international evidence and practice sources",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "catalogue": "node scripts/build-catalogue.mjs",
    "build": "npm run catalogue && node scripts/build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs tests/database/*.test.mjs",
    "test:database": "node --test tests/database/*.test.mjs",
    "db:seed": "node scripts/build-seed.mjs",
    "logos:sync": "python3 scripts/sync-source-logos.py --missing",
    "prebuild": "npm run logos:sync"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10"
  }
}
